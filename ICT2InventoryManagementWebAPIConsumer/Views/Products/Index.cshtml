@model IEnumerable<ICT2InventoryManagementWebAPIConsumer.Models.Product>

@{
    ViewData["Title"] = "Product Inventory";
}

<h2 class="mb-4">Product Inventory</h2>

<div class="card bg-light mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Product Name</label>
                <input type="text" name="searchName" class="form-control" placeholder="Search..." value="@Context.Request.Query["searchName"]" />
            </div>
            
             @if(ViewBag.Categories != null)
            {
                <div class="col-md-3">
                    <label class="form-label">Category</label>
                    <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
                        <option value="">-- All Categories --</option>
                    </select>
                    @* <select name="categoryId" 
                            class="form-select" 
                            asp-items="(SelectList)ViewBag.Categories">
                        <option value="">-- All Categories --</option>
                    </select> *@
                    @* @foreach (var category in ViewBag.Categories)
                        {
                            @category.categoryName
                        } *@
                </div>
            }
            else
            {
                <div> @ViewBag.CategoryError</div>
            } 

            @* @if (ViewData["Categories"] != null)
            {
                <div class="col-md-3">
                    <label class="form-label">Category</label>
                    <select name="categoryId" class="form-select" 
                            asp-items='(IEnumerable<SelectListItem>)ViewData["Categories"]'>
                        <option value="">-- All Categories --</option>
                    </select>
                </div>
            } *@

            <div class="col-md-2">
                <label class="form-label">Min Price</label>
                <input type="number" name="minPrice" class="form-control" value="@Context.Request.Query["minPrice"]" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Max Price</label>
                <input type="number" name="maxPrice" class="form-control" value="@Context.Request.Query["maxPrice"]" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

<p>
    <a asp-action="Create" class="btn btn-success">Add New Product</a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Category</th>
            <th>Rate</th>
            <th>Description</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductId</td>
                <td>@item.ProductName</td>
                <td>@item.CategoryNavigation?.categoryName</td>
                <td>@item.Rate.ToString("C")</td>
                <td>@item.Description</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-primary">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
@model ICT2InventoryManagementWebAPIConsumer.Models.Product

<div class="row justify-content-center">
    <div class="col-md-6 mt-4">
        <div class="card shadow border-primary">
            <div class="card-header bg-primary text-white"><h4>Edit Product</h4></div>
            <div class="card-body">
                <form asp-action="Edit">
                    <input type="hidden" asp-for="ProductId" />

                    <div class="mb-3">
                        <label asp-for="ProductName" class="form-label"></label>
                        <input asp-for="ProductName" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Rate" class="form-label"></label>
                        <input asp-for="Rate" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Category</label>
                        <select asp-for="Category" class="form-select" asp-items="ViewBag.CategoryList"></select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Update</button>
                    <a asp-action="Index" class="btn btn-link">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

<form asp-action="SearchByRate">
    <div class="form-group">
        <label for="productName">Min Rate:</label>
        <input type="text" class="form-control" id="minRate" name="minRate" required />
    </div>
    <div class="form-group">
        <label for="productName">Max Rate:</label>
        <input type="text" class="form-control" id="maxRate" name="maxRate" required />
    </div>

    <button type="submit" class="btn btn-primary">Search</button>
</form>